{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5434;Database=events_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "EventManagementService.API",
    "Audience": "EventManagementService.API",
    "SigningKey": "замените_на_сильный_ключ_на_проде_32_байта"
  },
  "OpenTelemetry": {
    "ServiceName": "events-service"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ConsumerGroup": "events-service",
    "MaxHandlerAttempts": 5
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Cache": {
    "EventTtl": "00:10:00",
    "TopEventsTtl": "00:01:00"
  }
}
